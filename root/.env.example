RESEND_API_KEY=
CONTACT_TO=
# Cloudflare Turnstile (free). For local testing use Cloudflare's always-pass pair:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_ values are baked in at build time: redeploy after changing the site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Supabase (gallery storage + admin login). Project Settings > API: project URL and anon (publishable) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
